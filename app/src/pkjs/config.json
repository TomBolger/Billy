[
    {
        "type": "heading",
        "defaultValue": "Billy",
        "size": 1
    },
    {
        "type": "section",
        "items": [
            {
                "type": "heading",
                "defaultValue": "Assistant"
            },
            {
                "type": "input",
                "id": "GEMINI_API_KEY",
                "messageKey": "GEMINI_API_KEY",
                "label": "Gemini API key",
                "description": "Required. Billy thinks with Google Gemini using your own free key: open <a href=\"https://aistudio.google.com/app/apikey\">aistudio.google.com/app/apikey</a>, sign in, tap <b>Create API key</b>, copy it and paste it here, then tap Save. If you use Billy Companion on Android, paste the key there instead (this box can stay empty). The key stays on your phone.",
                "defaultValue": "",
                "attributes": {
                    "placeholder": "Paste your key",
                    "autocomplete": "off"
                }
            },
            {
                "type": "select",
                "id": "ASSISTANT_RUNTIME",
                "messageKey": "ASSISTANT_RUNTIME",
                "label": "Where Billy runs",
                "description": "Automatic (recommended) uses Billy Companion when it's installed on an Android phone, and otherwise runs right here in the Pebble app (iPhone too). Billy Companion adds Google Calendar, Gmail, texts, calls and more.",
                "defaultValue": "automatic",
                "options": [
                    {
                        "label": "Automatic (recommended)",
                        "value": "automatic"
                    },
                    {
                        "label": "Pebble app only",
                        "value": "companionless"
                    },
                    {
                        "label": "Billy Companion only",
                        "value": "android"
                    }
                ]
            },
            {
                "type": "select",
                "id": "GEMINI_MODEL",
                "messageKey": "GEMINI_MODEL",
                "label": "Gemini model",
                "description": "Used by both the phone runtime and Billy Companion. Flash models pick the right tool far more reliably than Flash-Lite. You can also change this on the watch under Settings.",
                "defaultValue": "gemini-3.8-flash",
                "options": [
                    {
                        "label": "Gemini 3.8 Flash (recommended)",
                        "value": "gemini-3.8-flash"
                    },
                    {
                        "label": "Gemini 3.6 Flash",
                        "value": "gemini-3.6-flash"
                    },
                    {
                        "label": "Gemini 3.5 Flash-Lite (bigger free allowance)",
                        "value": "gemini-3.5-flash-lite"
                    },
                    {
                        "label": "Gemini 3.1 Flash-Lite (cheapest)",
                        "value": "gemini-3.1-flash-lite"
                    },
                    {
                        "label": "Gemini 3.1 Pro (needs billing, slow)",
                        "value": "gemini-3.1-pro-preview"
                    }
                ]
            },
            {
                "type": "select",
                "id": "GEMINI_THINKING",
                "messageKey": "GEMINI_THINKING",
                "label": "Thinking",
                "description": "How hard Gemini thinks before answering. More thinking can give better answers to hard questions but is slower and uses more of your quota. You can also change this on the watch under Settings.",
                "defaultValue": "low",
                "options": [
                    {
                        "label": "Minimal (fastest)",
                        "value": "minimal"
                    },
                    {
                        "label": "Low (recommended)",
                        "value": "low"
                    },
                    {
                        "label": "Medium",
                        "value": "medium"
                    },
                    {
                        "label": "High (slowest)",
                        "value": "high"
                    }
                ]
            },
            {
                "type": "input",
                "id": "GEMINI_MONTHLY_BUDGET_USD",
                "messageKey": "GEMINI_MONTHLY_BUDGET_USD",
                "label": "Gemini monthly budget",
                "description": "Used only for Billy's local estimate on the Quota screen. Google AI Studio billing is authoritative.",
                "defaultValue": "10"
            },
            {
                "type": "input",
                "id": "USER_PROFILE_CONTEXT",
                "messageKey": "USER_PROFILE_CONTEXT",
                "label": "Billy profile context",
                "description": "Optional companionless memory/profile notes Billy should use, such as preferred name, home timezone, family names, pets, or preferences. Stored locally by the Pebble phone app.",
                "defaultValue": ""
            },
            {
                "type": "input",
                "id": "CALENDAR_LINKS",
                "messageKey": "CALENDAR_LINKS",
                "label": "Calendar links (phone-only mode)",
                "description": "Lets Billy read your calendar without the Android companion (works on iPhone). Paste one or more private iCal links separated by spaces. Google Calendar: Settings > your calendar > Integrate calendar > Secret address in iCal format. iCloud: share the calendar as Public and copy the link.",
                "defaultValue": ""
            }
        ]
